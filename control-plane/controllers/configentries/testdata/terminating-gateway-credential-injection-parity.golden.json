{
  "automountServiceAccountToken": false,
  "containers": [
    {
      "args": [
        "agent",
        "-config=/consul/vault-agent-config",
        "-exit-after-auth"
      ],
      "command": [
        "vault"
      ],
      "env": [
        {
          "name": "VAULT_ADDR",
          "value": "https://vault:8200"
        },
        {
          "name": "VAULT_CACERT",
          "value": "/consul/vault-ca/ca.crt"
        },
        {
          "name": "VAULT_NAMESPACE",
          "value": "camp"
        }
      ],
      "image": "hashicorp/vault:parity",
      "imagePullPolicy": "IfNotPresent",
      "name": "camp-vault-agent-init",
      "resources": {},
      "securityContext": {
        "allowPrivilegeEscalation": false,
        "capabilities": {
          "drop": [
            "ALL"
          ]
        },
        "readOnlyRootFilesystem": true,
        "runAsNonRoot": true,
        "runAsUser": 100,
        "seccompProfile": {
          "type": "RuntimeDefault"
        }
      },
      "volumeMounts": [
        {
          "mountPath": "/consul/vault-agent-config",
          "name": "camp-vault-agent-config",
          "readOnly": true
        },
        {
          "mountPath": "/consul/vault-agent-private",
          "name": "camp-vault-agent-private"
        },
        {
          "mountPath": "/consul/vault-ca",
          "name": "camp-vault-ca",
          "readOnly": true
        },
        {
          "mountPath": "/consul/vault-rendered",
          "name": "camp-vault-rendered"
        },
        {
          "mountPath": "/consul/vault-token",
          "name": "camp-vault-token",
          "readOnly": true
        }
      ]
    },
    {
      "args": [
        "agent",
        "-config=/consul/vault-agent-config"
      ],
      "command": [
        "vault"
      ],
      "env": [
        {
          "name": "VAULT_ADDR",
          "value": "https://vault:8200"
        },
        {
          "name": "VAULT_CACERT",
          "value": "/consul/vault-ca/ca.crt"
        },
        {
          "name": "VAULT_NAMESPACE",
          "value": "camp"
        }
      ],
      "image": "hashicorp/vault:parity",
      "imagePullPolicy": "IfNotPresent",
      "name": "camp-vault-agent",
      "resources": {},
      "securityContext": {
        "allowPrivilegeEscalation": false,
        "capabilities": {
          "drop": [
            "ALL"
          ]
        },
        "readOnlyRootFilesystem": true,
        "runAsNonRoot": true,
        "runAsUser": 100,
        "seccompProfile": {
          "type": "RuntimeDefault"
        }
      },
      "volumeMounts": [
        {
          "mountPath": "/consul/vault-agent-config",
          "name": "camp-vault-agent-config",
          "readOnly": true
        },
        {
          "mountPath": "/consul/vault-agent-private",
          "name": "camp-vault-agent-private"
        },
        {
          "mountPath": "/consul/vault-ca",
          "name": "camp-vault-ca",
          "readOnly": true
        },
        {
          "mountPath": "/consul/vault-rendered",
          "name": "camp-vault-rendered"
        },
        {
          "mountPath": "/consul/vault-token",
          "name": "camp-vault-token",
          "readOnly": true
        }
      ]
    },
    {
      "args": [
        "-config-file=/consul/processor-config/config.json",
        "-uds-path=/consul/auth-socket/auth.sock",
        "-log-level=info"
      ],
      "command": [
        "camp-auth-processor"
      ],
      "env": [],
      "image": "camp-auth-processor:parity",
      "imagePullPolicy": "IfNotPresent",
      "lifecycle": {
        "preStop": {
          "exec": {
            "command": [
              "camp-auth-processor",
              "drain-wait",
              "-duration=45s"
            ]
          }
        }
      },
      "livenessProbe": {
        "exec": {
          "command": [
            "camp-auth-processor",
            "health",
            "-uds-path=/consul/auth-socket/auth.sock",
            "-live"
          ]
        },
        "failureThreshold": 6,
        "initialDelaySeconds": 15,
        "periodSeconds": 10,
        "timeoutSeconds": 5
      },
      "name": "camp-auth-processor",
      "readinessProbe": {
        "exec": {
          "command": [
            "camp-auth-processor",
            "health",
            "-uds-path=/consul/auth-socket/auth.sock",
            "-ready"
          ]
        },
        "failureThreshold": 3,
        "initialDelaySeconds": 5,
        "periodSeconds": 10,
        "timeoutSeconds": 5
      },
      "resources": {
        "limits": {
          "cpu": "50m",
          "memory": "50Mi"
        },
        "requests": {
          "cpu": "50m",
          "memory": "50Mi"
        }
      },
      "securityContext": {
        "allowPrivilegeEscalation": false,
        "capabilities": {
          "drop": [
            "ALL"
          ]
        },
        "readOnlyRootFilesystem": true,
        "runAsNonRoot": true,
        "seccompProfile": {
          "type": "RuntimeDefault"
        }
      },
      "volumeMounts": [
        {
          "mountPath": "/consul/processor-config",
          "name": "camp-auth-processor-config",
          "readOnly": true
        },
        {
          "mountPath": "/consul/auth-socket",
          "name": "camp-auth-socket"
        },
        {
          "mountPath": "/consul/vault-rendered",
          "name": "camp-vault-rendered",
          "readOnly": true
        }
      ]
    }
  ],
  "securityContext": {
    "fsGroup": 10001
  },
  "terminationGracePeriodSeconds": 60,
  "volumes": [
    {
      "configMap": {
        "name": "camp-proc"
      },
      "name": "camp-auth-processor-config"
    },
    {
      "emptyDir": {
        "medium": "Memory"
      },
      "name": "camp-auth-socket"
    },
    {
      "configMap": {
        "name": "camp-agent"
      },
      "name": "camp-vault-agent-config"
    },
    {
      "emptyDir": {
        "medium": "Memory"
      },
      "name": "camp-vault-agent-private"
    },
    {
      "configMap": {
        "name": "camp-ca"
      },
      "name": "camp-vault-ca"
    },
    {
      "emptyDir": {
        "medium": "Memory"
      },
      "name": "camp-vault-rendered"
    },
    {
      "name": "camp-vault-token",
      "projected": {
        "sources": [
          {
            "serviceAccountToken": {
              "audience": "vault",
              "expirationSeconds": 600,
              "path": "token"
            }
          }
        ]
      }
    },
    {
      "name": "consul-auth-method-sa-token",
      "projected": {
        "sources": [
          {
            "serviceAccountToken": {
              "expirationSeconds": 7200,
              "path": "token"
            }
          }
        ]
      }
    }
  ]
}
